# Lab description for the chaos suite. Copy and edit for another lab.
# Nodes: name=ip pairs. The suite crashes nodes; nothing on them is safe.
NODES="pve-01=192.168.35.107 pve-02=192.168.35.108"
# Test guest living on the pool, with the qemu guest agent enabled.
VMID=900
# PVE storage id of the pool and the storage for the verifier disk.
STORAGE=noxpool
# nox pool name (the daemon's --pool; dm devices are <POOL>-<volume>).
POOL=nox
# SCSI WWID of the pool LUN (the part after /dev/disk/by-id/scsi-).
WWID=36001405b42cf859984a4173b8b4de5c8
# Size of the verifier disk in GiB (created as scsi1 of the guest if missing).
VERIFIER_GB=2
# iSCSI portal the nodes use for the pool LUN (for the path loss scenarios).
TARGET_IP=192.168.35.6
# ssh target on the iSCSI server with passwordless sudo, for the both-paths
# scenario (targetcli). Leave empty to disable that scenario.
TARGET_SSH="otnops@192.168.35.6"
TARGET_IQN="iqn.2021-04.com.45lab:storage.proxmox"
