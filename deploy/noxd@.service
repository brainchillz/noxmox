[Unit]
Description=nox shared block pool daemon (pool %i)
Documentation=https://github.com/brainchillz/noxmox
After=sanlock.service wdmd.service iscsid.service open-iscsi.service multipathd.service
Wants=sanlock.service
Before=pve-guests.service

[Service]
Type=simple
EnvironmentFile=/etc/nox/%i.conf
ExecStart=/usr/sbin/nox daemon --pool %i --device ${NOX_DEVICE} --host-id ${NOX_HOST_ID}
Restart=always
RestartSec=3
# leases are orphaned on exit on purpose; never SIGKILL mid-operation
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
