[Unit]
Description=nox shared block pool daemon
Documentation=file:/usr/share/doc/nox
After=sanlock.service wdmd.service iscsid.service open-iscsi.service
Wants=sanlock.service
Before=pve-guests.service

[Service]
Type=simple
EnvironmentFile=/etc/default/noxd
ExecStart=/usr/local/sbin/nox daemon --device ${NOX_DEVICE} --host-id ${NOX_HOST_ID} --socket /run/noxd.sock
Restart=always
RestartSec=3
# leases are orphaned on exit on purpose; never SIGKILL mid-operation
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
